{
  "presets": [
    "@babel/preset-env",
    "@babel/preset-react"
  ],
  "ignore": ["*.scss", "*.css"],
  "plugins": ["transform-class-properties"],
  "env": {
    "production": {
      "plugins": [
        "transform-class-properties",
        [
          "transform-react-remove-prop-types", {
            "mode": "remove",
            "removeImport": true
          }
        ]
      ]
    }
  }
}
